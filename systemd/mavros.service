# mavros au boot. Même chose que `make mavros`, emballé par systemd.
# __REPO__ est remplacé par le chemin du repo par `make deploy`.
[Unit]
Description=mavros (docker compose), attend le port série
After=docker.service network-online.target lo-multicast.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=__REPO__
# FCU_DEVICE, le port série du Pixhawk, vient de .env (le - : fichier facultatif)
EnvironmentFile=-__REPO__/.env
# Attend que ce port existe. $$ devient $ : c'est bash, pas systemd, qui lit la variable et son défaut.
ExecStartPre=/bin/bash -lc 'until [ -c "$${FCU_DEVICE:-/dev/ttyTHS1}" ]; do sleep 1; done'
ExecStart=/usr/bin/docker compose -f compose/mavros.yml up
ExecStop=/usr/bin/docker compose -f compose/mavros.yml down
Restart=always
RestartSec=2
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
